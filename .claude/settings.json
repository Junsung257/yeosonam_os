{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff HEAD)",
      "Bash(git log --oneline -20)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(npx tsc --noEmit*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "Bash(vercel*)",
      "Bash(supabase*)",
      "Bash(node db/*)",
      "Bash(npm run *:apply*)",
      "Bash(npm run *:enable*)",
      "Bash(npm run *:production*)",
      "Bash(npm run type-check)",
      "Bash(npm test*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(./.mcp.json)",
      "Read(./.codex/**)",
      "Read(//c/Users/admin/.codex/**)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(supabase db reset*)",
      "Bash(supabase db push*)"
    ]
  }
}
